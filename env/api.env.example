# Copiar a api.env en el VPS:  cp env/api.env.example env/api.env
# Las credenciales de DB se inyectan desde el .env raíz vía compose.yaml
# (DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD, DB_NAME). No duplicarlas aquí.

PORT=3000
NODE_ENV=production
CORS=http://client-cine-upea.bo
JWT_SECRET=cambiar_esta_clave_jwt_minimo_10_caracteres
JWT_EXPIRES_IN=2h
