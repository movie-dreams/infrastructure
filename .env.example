# Copiar en el VPS:  cp .env.example .env
# Luego:            cp env/api.env.example env/api.env

# Docker Hub + tags (CI/CD actualiza API_TAG y FRONTEND_TAG)
DOCKER_USERNAME=tu_usuario_dockerhub
API_TAG=latest
FRONTEND_TAG=latest

# PostgreSQL (también se inyectan a la API como DB_*)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_clave_segura
POSTGRES_DB=db_cine
